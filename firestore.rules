rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation functions
    function isValidUser(data) {
      return data.keys().hasAll(['email', 'fullName', 'joinedDate', 'preferredSize', 'favorites'])
        && data.keys().size() == 5
        && data.email is string && data.email.size() <= 256
        && data.fullName is string && data.fullName.size() <= 256
        && data.joinedDate is string && data.joinedDate.size() <= 128
        && data.preferredSize is number
        && data.favorites is list
        && data.favorites.size() <= 100;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'date', 'total', 'status', 'items'])
         && data.keys().size() == 5
         && data.id is string && data.id.size() <= 128
         && data.date is string && data.date.size() <= 128
         && data.total is number
         && data.status is string && data.status.size() <= 64
         && data.items is list
         && data.items.size() <= 50;
    }

    // Collection matches
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['favorites', 'preferredSize', 'fullName'])
      );

      match /orders/{orderId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(orderId) && isValidOrder(incoming());
      }
    }
  }
}
